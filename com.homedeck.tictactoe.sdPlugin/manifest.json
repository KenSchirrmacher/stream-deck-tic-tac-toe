{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Tic-Tac-Toe",
  "Version": "1.0.0.0",
  "Author": "Home Deck",
  "Description": "Turn nine keys into a Tic-Tac-Toe board. Pass the deck back and forth — X and O alternate automatically, a win highlights the three in a row, and the board clears itself a moment later for a rematch.",
  "Icon": "imgs/plugin/plugin-icon",
  "Category": "Tic-Tac-Toe",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "DefaultWindowSize": [
    420,
    420
  ],
  "UUID": "com.homedeck.tictactoe",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Actions": [
    {
      "Name": "Cell",
      "UUID": "com.homedeck.tictactoe.cell",
      "Icon": "imgs/actions/cell/icon",
      "Tooltip": "One square of the Tic-Tac-Toe board. Place exactly nine of these in a 3x3 block on a folder page.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/cell/icon",
          "ShowTitle": false
        }
      ]
    }
  ]
}